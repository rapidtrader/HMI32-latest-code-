# npm run dev — browser calls http://localhost:5173/api/* (no CORS); Vite proxies below.
# Socket.IO connects directly to VITE_DEV_PROXY_TARGET (not Vite ws proxy — avoids ECONNABORTED noise).
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=https://hmi.dynacleanindustries.com
VITE_PI_BACKEND_URL=https://hmi.dynacleanindustries.com

# Local Node backend instead of production:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:4002
# VITE_PI_BACKEND_URL=http://127.0.0.1:4002
