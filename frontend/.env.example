# Copy to .env / .env.development / .env.production as needed

# Production build (same-origin on hmi.dynacleanindustries.com)
VITE_API_BASE_URL=
VITE_PI_BACKEND_URL=https://hmi.dynacleanindustries.com

# npm run dev — leave API base empty; use proxy (avoids CORS from localhost:5173)
# VITE_API_BASE_URL=
# VITE_DEV_PROXY_TARGET=https://hmi.dynacleanindustries.com

# Local PC backend + Pi via Tailscale
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:4002
# VITE_PI_BACKEND_URL=http://100.90.128.80:4002
