# Production VPS: /var/www/hmi/backend/.env — ONE copy of each key only.
# Copy MONGODB_URI from: grep '^MONGODB_URI=' /var/www/gps-tracking/Backend/.env

NODE_ENV=production
HOST=0.0.0.0
PORT=4002

MONGODB_URI=mongodb+srv://USER:PASS@cluster0.o0rpewf.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=gpsDB
# Must match gps-backend URI (not cluster0.xscax6b). Code adds &family=4 for SRV if missing.
# Atlas → Network Access: allow VPS public IP (e.g. 72.61.237.99) or 0.0.0.0/0 during setup.

JWT_SECRET=change-me-long-random-hex
JWT_EXPIRES_IN=7d

PUBLIC_APP_URL=https://hmi.dynacleanindustries.com

# PM2 ecosystem also sets these; ok to duplicate here:
# FFMPEG_PATH=/usr/bin/ffmpeg
# NODE_OPTIONS=--dns-result-order=ipv4first
