MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gpsDB
# Optional: old DB URI for one-time migration (node scripts/migrate-hmi32-data.js)
SOURCE_MONGODB_URI=
SOURCE_MONGODB_DB_NAME=gpsDB
PORT=4002
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (configured in src/server.js): local (5173/5174) + hmi.dynacleanindustries.com

# On Raspberry Pi (abcd_latest), set data/backend.json:
#   "backendBaseUrl": "https://hmi.dynacleanindustries.com"
# Local dev example:
#   export BACKEND_BASE_URL=http://<your-pc-ip>:4002
# Socket.IO uses the same URL unless SOCKET_IO_URL is set separately.
