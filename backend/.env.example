MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gpsDB
# Optional: old DB URI for one-time migration (node scripts/migrate-hmi32-data.js)
SOURCE_MONGODB_URI=
SOURCE_MONGODB_DB_NAME=gpsDB
PORT=4002
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Production public URL (Pi abcd_latest/data/backend.json + frontend VITE_API_BASE_URL)
PUBLIC_APP_URL=https://hmi.dynacleanindustries.com

# Windows local dev — clip merge needs ffmpeg (winget install Gyan.FFmpeg):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# CORS (configured in src/server.js): local (5173/5174) + hmi.dynacleanindustries.com

# Raspberry Pi — data/backend.json:
#   "backendBaseUrl": "https://hmi.dynacleanindustries.com"
#   "cameraAutoSave": true
# Or: bash scripts/set_backend_production.sh

# Local dev only:
#   "backendBaseUrl": "http://<your-pc-ip>:4002"
# Socket.IO uses backendBaseUrl unless SOCKET_IO_URL is set separately.

# Camera video merge (background) — faster live append:
# CAMERA_VIDEO_MERGE_DEBOUNCE_MS=450
# CAMERA_VIDEO_MERGE_BATCH=10
# CAMERA_VIDEO_FASTSTART_MAX_MB=32
# CAMERA_VIDEO_GRIDFS_DELETE_DELAY_MS=180000
# CAMERA_VIDEO_CACHE_DIR=/var/tmp/hmi32-roll-cache
